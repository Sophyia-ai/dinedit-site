{
  "routes": [
    { "route": "/architectes", "redirect": "/a-propos", "statusCode": 301 },
    { "route": "/en/architectes", "redirect": "/en/a-propos", "statusCode": 301 },
    { "route": "/nl/architectes", "redirect": "/nl/a-propos", "statusCode": 301 }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/images/*",
      "/widget/*",
      "/*.{js,css,jpg,jpeg,png,ico,svg,webp,xml,txt,json}"
    ]
  },
  "platform": {
    "apiRuntime": "node:18"
  },
  "mimeTypes": {
    ".json": "application/json"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff"
  }
}
